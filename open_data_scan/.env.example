# Sao chép file này thành .env rồi điền giá trị thật:   cp .env.example .env && chmod 600 .env
# Không đưa .env lên git, không gửi qua chat hay email.

# Ứng dụng Lark của công ty (xem INSTALL_IT.md mục 3). Ứng dụng phải được thêm vào Base với quyền chỉnh sửa.
LARK_APP_ID="cli_xxxxxxxxxxxxxxxx"
LARK_APP_SECRET="thay_bang_app_secret"

# Lark quốc tế (địa chỉ Base dạng ...larksuite.com): để nguyên. Chỉ đổi nếu công ty dùng Feishu (open.feishu.cn).
LARK_DOMAIN="https://open.larksuite.com"

# Khóa data.gov.sg (KHÔNG bắt buộc). Có khóa thì giới hạn tốc độ cao hơn. Để trống nếu chưa có.
DATA_GOV_SG_API_KEY=""
